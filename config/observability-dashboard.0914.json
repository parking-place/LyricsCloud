{
  "version": "0.9.1-phase4",
  "title": "LyricsCloud operational health",
  "aggregationOnly": true,
  "panels": [
    { "metric": "service_unavailable_count", "display": "Service readiness failures" },
    { "metric": "autosave_failure_rate_percent", "display": "Autosave failure rate" },
    { "metric": "sync_conflict_count", "display": "Explicit sync conflicts" },
    { "metric": "search_p95_ms", "display": "Search p95" },
    { "metric": "purge_failure_count", "display": "Purge failures" },
    { "metric": "backup_failure_count", "display": "Backup failures" },
    { "metric": "backup_age_seconds", "display": "Latest valid backup age" },
    { "metric": "backup_size_bytes", "display": "Latest encrypted backup size" }
  ],
  "forbiddenDimensions": ["user", "account", "email", "resourceId", "documentId", "requestId", "routeUrl", "searchQuery"]
}
