<Window
    x:Class="LyricsCloud.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LyricsCloud · Windows 읽기 전용">
    <Grid x:Name="RootGrid" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="LYRICSCLOUD" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Windows 라이브러리" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="곡·가사·라임·프롬프트를 읽고 정확히 복사합니다." TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="v1.1.8 · READ ONLY" VerticalAlignment="Center"
                       AutomationProperties.Name="앱 버전 1.1.8, 읽기 전용" />
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsOpen="True" IsClosable="False"
                 Title="연결 필요" Message="HTTPS 서버에 연결한 뒤 시스템 브라우저로 로그인해 주세요."
                 AutomationProperties.LiveSetting="Polite" />

        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrowserColumn" Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BrowserColumn.Width" Value="340" />
                            <Setter Target="DetailColumn.Width" Value="*" />
                            <Setter Target="BrowserPane.(Grid.RowSpan)" Value="2" />
                            <Setter Target="DetailPane.(Grid.Column)" Value="1" />
                            <Setter Target="DetailPane.(Grid.Row)" Value="0" />
                            <Setter Target="DetailPane.(Grid.RowSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="BrowserPane" Grid.Row="0" Padding="16" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ServerOriginTextBox" Header="LyricsCloud 서버" PlaceholderText="https://lyrics.example.com"
                             AutomationProperties.HelpText="HTTPS로 시작하는 LyricsCloud 서버 주소" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectButton" Content="서버 연결" Click="ConnectButton_Click" />
                        <Button x:Name="SignInButton" Content="브라우저 로그인" Click="SignInButton_Click" IsEnabled="False" />
                        <Button x:Name="LogoutButton" Content="로그아웃" Click="LogoutButton_Click" IsEnabled="False" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ResourceKindComboBox" Header="자료 종류" SelectedIndex="0"
                                  SelectionChanged="ResourceKindComboBox_SelectionChanged">
                            <ComboBoxItem Content="곡과 가사" />
                            <ComboBoxItem Content="라임 노트" />
                            <ComboBoxItem Content="프롬프트" />
                        </ComboBox>
                        <Button Grid.Column="1" x:Name="RefreshButton" Content="새로 고침" VerticalAlignment="Bottom"
                                Click="RefreshButton_Click" IsEnabled="False" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <ListView x:Name="ResourceListView" SelectionMode="Single"
                                  SelectionChanged="ResourceListView_SelectionChanged"
                                  AutomationProperties.Name="자료 목록">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.72" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="자료를 불러오는 중" />
                    </Grid>
                    <Button Grid.Row="4" x:Name="LoadMoreButton" Content="다음 자료 불러오기" HorizontalAlignment="Stretch"
                            Click="LoadMoreButton_Click" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border x:Name="DetailPane" Grid.Row="1" Padding="18" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailTitle" Text="자료를 선택해 주세요" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Row="1" x:Name="DetailMetadata" Text="선택한 자료의 원문을 수정 없이 표시합니다."
                               Opacity="0.72" TextWrapping="Wrap" />
                    <ListView Grid.Row="2" x:Name="LyricListView" MaxHeight="160" Visibility="Collapsed"
                              SelectionChanged="LyricListView_SelectionChanged" AutomationProperties.Name="선택한 곡의 가사 목록">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Padding="4" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBox Grid.Row="3" x:Name="DetailBody" Text="" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" IsSpellCheckEnabled="False"
                             AutomationProperties.Name="읽기 전용 원문" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CopyButton" Content="전체 복사" Click="CopyButton_Click" IsEnabled="False"
                                AutomationProperties.AcceleratorKey="Alt+Shift+C"
                                AutomationProperties.HelpText="표시된 원문을 자르지 않고 클립보드에 복사">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="C" Modifiers="Menu,Shift" Invoked="CopyKeyboardAccelerator_Invoked" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <TextBlock x:Name="CopyLengthText" VerticalAlignment="Center" Text="복사할 자료 없음" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="원문은 서버의 현재 읽기 응답입니다. 이 앱은 편집·초안·Yjs 업데이트·서버 쓰기를 제공하지 않습니다. 공유 자료는 온라인 권한 재확인 뒤에만 표시합니다."
                   TextWrapping="Wrap" Opacity="0.72" AutomationProperties.Name="읽기 전용 및 원문 보관 한계 안내" />
    </Grid>
</Window>
