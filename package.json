{
  "name": "lyricscloud",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0 <25", "pnpm": ">=11.0.0 <12" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck",
    "boundaries": "node scripts/check-boundaries.mjs",
    "dev": "pnpm --filter @lyricscloud/web dev",
    "lint": "pnpm boundaries",
    "start": "pnpm --filter @lyricscloud/web start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present check",
    "migrate": "pnpm --filter @lyricscloud/database migrate"
  },
  "devDependencies": { "@playwright/test": "1.62.1", "@types/node": "24.10.0", "typescript": "5.9.3", "vitest": "4.0.18" }
}
