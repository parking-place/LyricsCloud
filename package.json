{
  "name": "lyricscloud",
  "version": "1.0.9",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm typecheck",
    "check:secrets": "node scripts/check-secret-leaks.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "docker:cleanup": "bash scripts/cleanup-docker.sh --build-cache",
    "boundaries": "node scripts/check-boundaries.mjs",
    "admin": "pnpm --filter @lyricscloud/database exec tsx src/beta-admin.ts",
    "dev": "pnpm --filter @lyricscloud/web dev",
    "lint": "pnpm boundaries",
    "start": "pnpm --filter @lyricscloud/web start",
    "test": "vitest run",
    "test:migration:0200": "node scripts/verify-0200-migration.mjs",
    "test:migration:0300": "node scripts/verify-0300-migration.mjs",
    "test:migration:0310": "node scripts/verify-0310-migration.mjs",
    "test:migration:0311": "node scripts/verify-0311-migration.mjs",
    "test:migration:0400": "node scripts/verify-0400-migration.mjs",
    "test:migration:0500": "node scripts/verify-0500-migration.mjs",
    "test:migration:0501": "node scripts/verify-0501-migration.mjs",
    "test:migration:0700": "node scripts/verify-0700-migration.mjs",
    "test:migration:0701": "node scripts/verify-0701-migration.mjs",
    "test:migration:0702": "node scripts/verify-0702-migration.mjs",
    "test:migration:0800": "node scripts/verify-0800-migration.mjs",
    "test:migration:0801": "node scripts/verify-0801-migration.mjs",
    "test:migration:0802": "node scripts/verify-0802-migration.mjs",
    "test:migration:0900": "node scripts/verify-0900-migration.mjs",
    "test:migration:0901": "node scripts/verify-0901-migration.mjs",
    "test:migration:1000": "node scripts/verify-1000-migration.mjs",
    "test:migration:1001": "node scripts/verify-1001-migration.mjs",
    "test:migration:1002": "node scripts/verify-1002-migration.mjs",
    "test:beta-admin:0900": "pnpm --filter @lyricscloud/database exec tsx ../../scripts/verify-0900-beta-admin.ts",
    "test:beta-signup:0901": "BETA_SIGNUP_DATABASE_INTEGRATION=true vitest run packages/database/src/beta-signup.integration.test.ts",
    "test:audit:0901": "node scripts/validate-0901-ui-audit.mjs",
    "test:pwa:0903": "node scripts/verify-0903-pwa.mjs",
    "test:release:0905": "node scripts/validate-0905-release-candidate.mjs",
    "test:release:0905:complete": "node scripts/validate-0905-release-candidate.mjs --require-physical",
    "test:freeze:0911": "node scripts/validate-0911-feature-freeze.mjs",
    "test:security:0912": "node scripts/validate-0912-security-hardening.mjs",
    "test:performance:0913": "pnpm --filter @lyricscloud/database exec tsx ../../scripts/measure-0913-performance.ts",
    "test:release:0913": "node scripts/validate-0913-performance.mjs",
    "test:observability:0914": "pnpm --filter @lyricscloud/database exec tsx ../../scripts/probe-0914-observability.ts",
    "test:release:0914": "node scripts/validate-0914-observability.mjs",
    "test:release:0915": "node scripts/validate-0915-release-operations.mjs",
    "test:release:1001": "node scripts/validate-1001-final-gate.mjs",
    "test:release:1002": "node scripts/validate-1002-release-artifacts.mjs",
    "test:release:1004": "node scripts/validate-1004-documentation.mjs",
    "test:release:1005": "node scripts/validate-1005-final-release.mjs",
    "test:release:1005:tag": "node scripts/validate-1005-final-release.mjs --require-release",
    "test:environment:101": "node scripts/validate-101-environment.mjs",
    "test:rc:0913": "bash scripts/run-0913-rc.sh",
    "test:e2e:release:0905": "playwright test --config=playwright.release.config.ts tests/e2e/release-candidate.spec.ts",
    "test:performance:0700": "node scripts/measure-0700-search.mjs",
    "test:migration:0700-release": "node scripts/verify-0700-release-migration.mjs",
    "test:performance:0700-release": "pnpm --filter @lyricscloud/database exec tsx ../../scripts/measure-0700-navigation.ts",
    "test:migration:0201": "node scripts/verify-0201-migration.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present check",
    "migrate": "pnpm --filter @lyricscloud/database migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "esbuild": "0.28.2",
    "pg": "8.16.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
