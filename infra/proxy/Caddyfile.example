{
  email ops@example.invalid
}

lyrics.example.invalid {
  encode zstd gzip

  @avatarUpload {
    method PATCH
    path /api/profile/avatar
  }
  handle @avatarUpload {
    # The app accepts 2 MiB plus 50 KiB for the multipart envelope.
    request_body {
      max_size 2200000
    }
    reverse_proxy web:3000 {
      header_up -CF-Connecting-IP
      header_up -X-Real-IP
    }
  }

  handle_path /collaboration/* {
    request_body {
      max_size 2MB
    }
    reverse_proxy collaboration:3001 {
      header_up -CF-Connecting-IP
      header_up -X-Real-IP
    }
  }
  handle {
    request_body {
      max_size 2MB
    }
    reverse_proxy web:3000 {
      header_up -CF-Connecting-IP
      header_up -X-Real-IP
    }
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}
