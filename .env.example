# Copy to .env and replace every CHANGE_ME value. Never commit .env.
NODE_ENV=development
POSTGRES_DB=lyricscloud
POSTGRES_USER=lyricscloud
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://lyricscloud:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/lyricscloud
APP_VERSION=1.0.0
BUILD_ID=local

# Google Cloud Console redirect URI: http://localhost:8080/api/auth/callback
APP_ORIGIN=http://localhost:8080
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
# Copy .test_users.example to .test_users and enter one allowed email per line.
# Test-only issuer override. Production always requires https://accounts.google.com.
# GOOGLE_ISSUER=http://127.0.0.1:9090

WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
COLLABORATION_PORT=3001
WORKER_HEALTH_PORT=3002

# Disposable test database. Never point this URL at development or production data.
TEST_DATABASE_URL=postgresql://lyricscloud_test:lyricscloud_test_only@postgres_test:5432/lyricscloud_test

# Backup values are consumed only with compose.backup.yaml. The repository path must be
# an externally mounted filesystem, not this checkout or the PostgreSQL data volume.
BACKUP_REPOSITORY_PATH=/mnt/lyricscloud-backup
BACKUP_STORAGE_ID=CHANGE_ME_EXTERNAL_STORAGE_ID
BACKUP_POSTGRES_PASSWORD_FILE=/etc/lyricscloud/secrets/postgres_backup_password
BACKUP_AGE_RECIPIENT_FILE=/etc/lyricscloud/secrets/backup_age_recipient
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=24
BACKUP_MIN_FREE_BYTES=67108864
